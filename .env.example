# --- LLM Provider ---
# vllm (default) | openai
LLM_PROVIDER=vllm

# Fallback provider if primary is unavailable (none | vllm | openai)
LLM_FALLBACK=none

# --- vLLM / OpenAI-compatible local inference ---
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_API_KEY=
# Optional separate embedding server (defaults to VLLM_BASE_URL)
# VLLM_EMBED_BASE_URL=http://localhost:8013
# VLLM_EMBED_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSLATE_MODEL=gpt-4.1-mini
# OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Nexus Mods ---
# Personal API key for Nexus Mods GraphQL API v2
# Get it here: https://www.nexusmods.com/users/myaccount?tab=api
NEXUS_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://localizer:localizer@localhost:5433/localizer
# DB_POOL_MAX=25
# DB_STATEMENT_TIMEOUT_MS=0
# DB_IDLE_IN_TX_TIMEOUT_MS=3600000
# Raise DB_POOL_MAX when using scan:mods --parallel N (e.g. 10 for parallel=3)

# --- Mod import performance ---
# MOD_IMPORT_BATCH_SIZE=5000
# MOD_IMPORT_PROGRESS_EVERY=10000
# MOD_IMPORT_IO_PARALLEL=4

# --- Runtime data (logs, uploads, cache, postgres files) ---
DATA_DIR=./data
# Local folder for scan:mods archive extraction (default: DATA_DIR/cache/scan-extract)
# SCAN_EXTRACT_DIR=./data/cache/scan-extract
# DB dump/restore default path: DATA_DIR/backups/localizer.dump (override with --out / --file)
# BACKUP_DIR=./data/backups
# Champollion.exe — on-demand PEX decompilation for script context in the mod editor
# Default after install: data/tools/champollion/Champollion.exe (npm run tools:champollion)
# CHAMPOLLION_PATH=C:\Tools\Champollion\Champollion.exe

# --- Translation ---
# Number of strings sent to LLM per batch
BATCH_SIZE=30
# Flush LLM batch early when combined source text exceeds this (chars)
LLM_BATCH_MAX_SOURCE_CHARS=12000
# Send a row alone when its source text exceeds this length (chars, default 500)
# LLM_BATCH_MAX_SINGLE_SOURCE_CHARS=500
# Max concurrent LLM chat/translate HTTP requests (1–32)
LLM_MAX_PARALLEL=2
# Max concurrent embedding HTTP requests (1–32)
EMBED_MAX_PARALLEL=4
# Texts per RAG embed HTTP call — lower if embed server returns 413 (default 8)
# RAG_EMBED_BATCH_SIZE=8
# Source rows loaded from DB per translate page (default 100)
# LLM_TRANSLATE_DB_CHUNK_SIZE=100
# Max tokens per chat completion response (default 16384)
LLM_MAX_TOKENS=16384
# Max LLM retries on transient errors / invalid JSON (default 5)
LLM_MAX_ATTEMPTS=5
# OpenAI SDK HTTP timeout per request in seconds (default 600 = 10 min)
# LLM_REQUEST_TIMEOUT_SEC=600
# Strings per LLM request during AI review (default: 10; smaller = steadier progress)
# Verify: per-request deadline in seconds (default 45; abort + retry before SDK timeout)
# Also used by skip-detect (non-translatable string scan).
LLM_VERIFY_TIMEOUT_SEC=45

# Verify: rows per LLM HTTP request (default 1 — one slow row must not block a batch)
LLM_VERIFY_BATCH_SIZE=1

# Skip-detect: rows per LLM HTTP request (default: BATCH_SIZE — no RAG, batching is safe; chunkRecovery splits on timeout)
# LLM_SKIP_DETECT_BATCH_SIZE=20

# --- Logging ---
# Log level: error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# --- Upload limits ---
# Maximum multipart file upload size in megabytes (default: 1024 MB = 1 GiB)
UPLOAD_MAX_FILE_SIZE_MB=1024

# --- Debug ---
# DEBUG=1
