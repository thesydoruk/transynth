# --- LLM Provider ---
# vllm (default) | openai
LLM_PROVIDER=vllm

# Fallback provider if primary is unavailable (none | vllm | openai)
LLM_FALLBACK=none

# --- vLLM / OpenAI-compatible local inference ---
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_API_KEY=
# Chat pool (hosts + per-server concurrency) lives in Settings → LLM (`llm.vllm_servers`).
# Optional env fallback when that setting is empty:
# VLLM_SERVERS=[{"host":"http://localhost:8000","maxParallel":4,"apiKey":""}]
# LLM_MAX_PARALLEL=2
# Optional separate embedding server (defaults to VLLM_BASE_URL or first chat host)
# VLLM_EMBED_BASE_URL=http://localhost:8013
# VLLM_EMBED_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSLATE_MODEL=gpt-4.1-mini
# OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Nexus Mods ---
# Personal API key for Nexus Mods GraphQL API v2
# Get it here: https://www.nexusmods.com/users/myaccount?tab=api
NEXUS_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://localizer:localizer@localhost:5433/localizer
# DB_POOL_MAX=25
# DB_STATEMENT_TIMEOUT_MS=0
# DB_IDLE_IN_TX_TIMEOUT_MS=3600000
# Raise DB_POOL_MAX when using scan:mods --parallel N (e.g. 10 for parallel=3)
# Rows per DB read/write page — translate, verify, skip-detect, TM, mod import (default 5000)
# DB_CHUNK_SIZE=5000

# --- Mod import performance ---
# MOD_IMPORT_PROGRESS_EVERY=10000
# MOD_IMPORT_IO_PARALLEL=4

# --- Runtime data (logs, uploads, cache, postgres files) ---
DATA_DIR=./data
# Local folder for scan:mods archive extraction (default: DATA_DIR/cache/scan-extract)
# SCAN_EXTRACT_DIR=./data/cache/scan-extract
# MOD_UPLOAD_DIR=./data/uploads/mod
# Web uploads and import extract trees share this root.
# DB dump/restore default path: DATA_DIR/backups/localizer.dump (override with --out / --file)
# BACKUP_DIR=./data/backups
# Champollion.exe — on-demand PEX decompilation for script context in the mod editor
# Default after install: data/tools/champollion/Champollion.exe (npm run tools:champollion)
# CHAMPOLLION_PATH=C:\Tools\Champollion\Champollion.exe

# --- Translation / verify ---
# Rows per LLM HTTP request (translate + verify batching)
BATCH_SIZE=30
# Flush LLM batch early when combined source text exceeds this (chars)
LLM_BATCH_MAX_SOURCE_CHARS=12000
# Send a row alone when its source text exceeds this length (chars, default 500)
# LLM_BATCH_MAX_SINGLE_SOURCE_CHARS=500
# Split long source/translation strings into sequential LLM calls (translate + verify, default 3500)
# LLM_TRANSLATE_TEXT_CHUNK_MAX_CHARS=3500
# Max line breaks per translate chunk — keeps placeholder masks manageable (default 12)
# LLM_TRANSLATE_TEXT_CHUNK_MAX_LINE_BREAKS=12
# Max concurrent LLM chat/translate HTTP requests (1–32)
LLM_MAX_PARALLEL=2
# Starting chat temperature; each subsequent LLM request lowers it by LLM_TEMPERATURE_DECAY (floor 0)
# LLM_TEMPERATURE=0.7
# LLM_TEMPERATURE_DECAY=0.02
# Max concurrent embedding HTTP requests (1–32)
EMBED_MAX_PARALLEL=4
# Texts per RAG embed HTTP call — lower if embed server returns 413 (default 8)
# RAG_EMBED_BATCH_SIZE=8
# Parallel workers per TM chunk — each worker uses its own DB transaction (default 1, max 16)
# TM_APPLY_WORKERS=4
# Max tokens per chat completion response (default 16384)
LLM_MAX_TOKENS=16384
# Max LLM retries on transient errors / invalid JSON (default 5)
LLM_MAX_ATTEMPTS=5
# OpenAI SDK HTTP timeout per request in seconds (default 600 = 10 min)
# LLM_REQUEST_TIMEOUT_SEC=600

# Skip-detect: parallel heuristic workers when LLM is off (default 4)
# SKIP_DETECT_WORKERS=4
# Skip-detect: rows per LLM HTTP batch (default: BATCH_SIZE)
# LLM_SKIP_DETECT_BATCH_SIZE=20

# --- Background job worker (BullMQ) ---
# Redis carries the job queue, live progress and cancellation.
# In docker compose this is set to redis://redis:6379 automatically.
# REDIS_URL=redis://localhost:6379
# Jobs the worker runs at the same time (default 8). LLM/TTS request pools
# still cap the real load (LLM_MAX_PARALLEL, Settings → Voice).
# JOB_CONCURRENCY=8
# TTL of the Redis snapshot behind job status polling, seconds (default 7200)
# JOB_SNAPSHOT_TTL_SEC=7200
# Rows kept in a job snapshot for reopened modals (default 2000)
# JOB_SNAPSHOT_MAX_ROWS=2000

# --- Web server ---
# Backend HTTP port (default 3000). Read by src/web/server.ts (also HOST, default 0.0.0.0).
# PORT=3000
# Docker host bind port — defaults to PORT when unset.
# WEB_PORT=3000

# --- Logging ---
# Log level: error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# --- Upload limits ---
# Optional multipart upload cap in megabytes. Unset = no practical application-level limit.
# (Fastify defaults to 1 MiB if this is not overridden in server startup.)
# UPLOAD_MAX_FILE_SIZE_MB=10240

# --- TTS (external Fish Speech service) ---
# POST /v1/synthesize — multipart: text, language, speaker_wav, speaker_text, backend=fish-speech
# TTS_BASE_URL=http://192.168.50.140:8080
#
# TTS concurrency is configured in Settings → Voice (project_settings).
# Reference clip mode (line vs speaker) is configured there too.

# --- Voice tooling (xWMAEncode, FaceFXWrapper, FonixData.cdf) ---
# Default install location: DATA_DIR/tools/voice/ (npm run tools:install)
# TOOLS_DIR=./data/tools
# VOICE_TOOLS_DIR=./data/tools/voice
# FACEFX_WRAPPER_PATH=
# FONIX_DATA_PATH=
# XWMA_ENCODE_PATH=
# On Linux/Docker, .exe tools run via Wine automatically (install wine/wine32/wine64 in the image).
# WINE_PATH=wine
# WINEPREFIX=./data/tools/.wine
# WINEPREFIX64=./data/tools/.wine64

# --- Debug ---
# DEBUG=1
