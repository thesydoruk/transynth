{
  "name": "storywealth-localizer-node",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n db,api,ui -c blue,green,magenta \"docker compose up db\" \"wait-on tcp:5432 && tsx watch src/web/server.ts\" \"wait-on tcp:3000 && npm --prefix web-ui run dev\"",
    "db:init": "tsx scripts/dbInit.ts",
    "learn:pairs": "tsx src/cli/learnFromMods.ts",
    "learn:multilang": "tsx src/cli/learnFromMultilangMod.ts",
    "translate": "tsx src/cli/translateMod.ts",
    "replace": "tsx src/cli/replaceFlow.ts",
    "import:eet": "tsx src/cli/importEet.ts",
    "eet2csv": "tsx src/cli/eet2csv.ts",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "web": "tsx src/web/server.ts",
    "web:dev": "tsx watch src/web/server.ts",
    "web:ui": "npm --prefix web-ui run dev",
    "web:build": "npm --prefix web-ui run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@types/archiver": "^7.0.0",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "fast-xml-parser": "^5.5.9",
    "fastify": "^5.8.4",
    "fuzzball": "^2.2.2",
    "lz4js": "^0.2.0",
    "node-7z": "^3.0.0",
    "openai": "^4.55.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "undici": "^6.19.8",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/node-7z": "^2.1.11",
    "@types/pg": "^8.20.0",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^4.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1",
    "wait-on": "^9.0.4"
  }
}
