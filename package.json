{
  "name": "storywealth-localizer-node",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/translateMod.ts",
    "db:init": "tsx scripts/dbInit.ts",
    "learn:pairs": "tsx src/cli/learnFromMods.ts",
    "learn:multilang": "tsx src/cli/learnFromMultilangMod.ts",
    "translate": "tsx src/cli/translateMod.ts",
    "replace": "tsx src/cli/replaceFlow.ts",
    "xedit:download": "tsx scripts/getXEdit.ts --family fo4 --dest ./tools/xedit --extract",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "fuzzball": "^2.2.2",
    "node-7z-archive": "^1.1.7",
    "openai": "^4.55.0",
    "undici": "^6.19.8",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1"
  }
}
