{
  "name": "transynth",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n db,api,ui -c blue,green,magenta \"docker compose up db\" \"wait-on tcp:5433 && tsx watch src/web/server.ts\" \"wait-on tcp:3000 && npm --prefix web-ui run dev\"",
    "db:init": "tsx scripts/dbInit.ts",
    "db:reset": "tsx scripts/dbReset.ts",
    "db:dump": "tsx scripts/dbDump.ts",
    "db:restore": "tsx scripts/dbRestore.ts",
    "rag:reindex": "tsx scripts/reindexRag.ts",
    "scan:mods": "tsx scripts/scanMods.ts",
    "detect:locale": "tsx scripts/detectModLocale.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "start:prod": "node --import tsx/esm src/web/server.ts",
    "web": "tsx src/web/server.ts",
    "web:dev": "tsx watch src/web/server.ts",
    "web:ui": "npm --prefix web-ui run dev",
    "web:build": "npm --prefix web-ui run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@types/archiver": "^7.0.0",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "fast-xml-parser": "^5.5.9",
    "fastify": "^5.8.4",
    "fuzzball": "^2.2.2",
    "lz4js": "^0.2.0",
    "node-7z": "^3.0.0",
    "openai": "^4.55.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "undici": "^6.19.8",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-7z": "^2.1.11",
    "@types/pg": "^8.20.0",
    "@types/yargs": "^17.0.33",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "lint-staged": "^16.1.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.1",
    "typescript": "^5.5.4",
    "wait-on": "^9.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml,css,scss,html}": "prettier --write"
  }
}
